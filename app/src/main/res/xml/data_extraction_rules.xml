<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Solo las cuotas viajan al backup / teléfono nuevo; la sesión (tokens) no. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="installments.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="installments.xml" />
    </device-transfer>
</data-extraction-rules>
